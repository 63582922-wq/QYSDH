# =============================================================================
# 环境变量模板 — 填好后使用方式（二选一）
# -----------------------------------------------------------------------------
# ① 本地开发：本文件另存为同目录下的  .env.local  （与 package.json 同级）
# ② Render 等：在面板「Environment」里逐项新增，变量名 = 下面每行 = 左侧大写 KEY
#
# 注意：密钥不要提交到 Git。.env.local 已被 .gitignore 忽略。
# 改完变量后：本地需重启 npm run dev；线上需重新 Deploy（重新 build）才进包。
#
# 下列「模型 ID」已在代码写死，勿再配环境变量：
#   · 文本对话 / 镌刻：gemini-2.5-flash
#   · Live 语音：gemini-3.1-flash-live-preview
# =============================================================================

# --- 必填：Google Gemini ---
GEMINI_API_KEY=

# --- Gemini Live：AI 说话用的 Google 预设音色名（不配则代码内为 Orus）---
GEMINI_LIVE_SPEECH_VOICE_NAME=
# 与上一行保持一致即可（供 Vite 注入 import.meta.env）
VITE_GEMINI_LIVE_SPEECH_VOICE_NAME=

# --- MiniMax：自动朗读 TTS / 上传复刻音色等（不配则朗读走浏览器 speechSynthesis）---
# 须开放平台「按量 API」类密钥；sk-cp- 类常不能调语音 HTTP。
MINIMAX_API_KEY=
# 国际默认 https://api.minimax.io；国内 Key 常填 https://api.minimaxi.com
MINIMAX_API_BASE=
# 控制台若要求 GroupId 再填
MINIMAX_GROUP_ID=
# 不配则代码默认 English_magnetic_voiced_man
MINIMAX_VOICE_ID=
# 不配则代码默认 speech-2.8-hd
MINIMAX_TTS_MODEL=
# 仅「上传录音复刻」POST /v1/voice_clone 用；不配则默认 speech-02-hd（勿与 T2A 的 MINIMAX_TTS_MODEL 混为一谈）
MINIMAX_VOICE_CLONE_MODEL=
# 不配则代码默认 1
MINIMAX_TTS_SPEED=

# --- MiniMax：图文对话专用 Key（与 TTS/复刻 的 MINIMAX_API_KEY 可不同；不配则对话沿用 MINIMAX_API_KEY）---
MINIMAX_CHAT_API_KEY=
# 与语音同域可留空；另域再填
MINIMAX_CHAT_API_BASE=
# 不配则代码默认 MiniMax-M2.7-highspeed
MINIMAX_CHAT_MODEL=
# 不配则代码默认 MiniMax-Text-01
MINIMAX_CHAT_VISION_MODEL=

# --- 可选：当前业务代码未读取，可留空 ---
APP_URL=

# Render「Add from .env」：
# · 最少：render.env.paste — 填 GEMINI、MINIMAX_API_KEY；若对话与语音 Key 不同再填 MINIMAX_CHAT_API_KEY（相同可留空或删该行）。
# · 国内全量：render.env.paste.cn — 同上，另含 MINIMAX_API_BASE 等；无 GroupId 可删 MINIMAX_GROUP_ID 行。
