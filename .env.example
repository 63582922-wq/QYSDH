# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# 可选：Multimodal Live 语音模型 ID（须为 …-live-preview 一类；官方名会变）。例：gemini-3.1-flash-live-preview。不填则按代码内默认列表依次尝试。
GEMINI_LIVE_VOICE_MODEL=""
# 点麦克风时：Gemini Live 回复的「说话音色」（Google 内置名，与 MiniMax 无关）。例：Orus、Charon、Sadachbia、Puck。留空默认 Orus
GEMINI_LIVE_SPEECH_VOICE_NAME=""
# 建议同时配置此项（Vite 会注入到浏览器，比仅靠 define 更可靠）：与上一行同名音色即可，如 Sadachbia
VITE_GEMINI_LIVE_SPEECH_VOICE_NAME=""

# MiniMax TTS（可选）：配置后「自动朗读」会用 MiniMax 合成语音，否则用浏览器 speechSynthesis。
# 须使用开放平台「按量付费 / API 密钥」类 Key；Token Plan / Coding Plan 的 sk-cp-… 不能调语音 HTTP API（会 invalid api key）。
# 密钥见 MiniMax 开放平台「API Keys」。开发环境请求走 Vite 代理 /minimax-api 以避免 CORS。
MINIMAX_API_KEY=""
# 留空则生产直连 https://api.minimax.io。国内控制台/文档多为 https://api.minimaxi.com（注意多一个 i），Key 若在国内申请请填该地址；开发时 Vite 会把 /minimax-api 代理到此处。
MINIMAX_API_BASE=""
# 若控制台除 API Key 外还提供「Group ID / 团队 ID」，填此处；请求会自动带上 ?GroupId=…（与 Token Plan 等套餐无关也可留空）
MINIMAX_GROUP_ID=""
# 音色 ID，见官方「System Voice」列表；留空则默认低沉磁性男声（English_magnetic_voiced_man），中文播客感可用 Chinese (Mandarin)_Male_Announcer
MINIMAX_VOICE_ID=""
# 如 speech-2.8-hd、speech-2.8-turbo；留空默认 speech-2.8-hd
MINIMAX_TTS_MODEL=""
# 语速，如 1、1.1；留空默认 1
MINIMAX_TTS_SPEED=""
# 在对话面板可「上传录音复刻音色」：先 POST /v1/files/upload，再 POST /v1/voice_clone；复刻得到的 voice_id 会存浏览器 localStorage。

# 克隆模式图文对话（MiniMax）。留空则自动使用上面的 MINIMAX_API_KEY；只有控制台另发了「对话专用 Key」时才填。
MINIMAX_CHAT_API_KEY=""
# 留空则对话与语音同一域名（MINIMAX_API_BASE）；若对话 API 与语音不在同一 host，填此处且开发时会自动增加 /minimax-chat-api 代理。
MINIMAX_CHAT_API_BASE=""
# 默认 MiniMax-M2.7-highspeed；以开放平台当前可用名为准。
MINIMAX_CHAT_MODEL=""
# 含图片时走原生 /v1/text/chatcompletion_v2，默认 MiniMax-Text-01（官方多模态示例）；若账户另有 VL 模型名可改此处。
MINIMAX_CHAT_VISION_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
